<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>create post</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="all_posts3">
        <h1>Make Your Note</h1>
        <div class="form">

            <form method="post" action="/notes">
                <div class="inputs">
                    <h3>TITLE: <input type="text" name="username" placeholder="enter you title." class="title"></h3>
                    <h3> CONTENT : <textarea name="content" id="content" placeholder="your new content" class="content" rows="9" cols="40"></textarea> </h3>
                    <button class="f_submit">ADD</button>

                </div>
            </form>
        </div>
    </div>
    
</body>
</html>